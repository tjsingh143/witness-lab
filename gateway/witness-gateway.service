# Witness gateway: inventory poller + HTTP API (software simulation lab; not hardware/firmware).
# Installed by scripts/provision_ctl.sh to /etc/systemd/system/witness-gateway.service; the code
# is the installed copy in /usr/local/lib/witness-gateway, the inventory /etc/witness/inventory.yaml.
#   start/stop/restart: systemctl start|stop|restart witness-gateway
#   status/logs:        systemctl status witness-gateway ; journalctl -u witness-gateway --since -10min
#   API (on ctl only):  curl -s http://127.0.0.1:8080/inventory ; curl -s http://127.0.0.1:8080/devices/dev-a
[Unit]
Description=Witness gateway (inventory poller every 2 s, HTTP API on 127.0.0.1:8080)
Documentation=file:/opt/witness-lab/docs/protocol.md
After=network.target systemd-networkd.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/usr/local/lib/witness-gateway
Environment=PYTHONPATH=/usr/local/lib/witness-gateway PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u -m gateway.gateway --inventory /etc/witness/inventory.yaml --listen 127.0.0.1:8080 --interval 2.0 --poll-deadline 4.0
Restart=on-failure
RestartSec=1
TimeoutStartSec=20
TimeoutStopSec=8
KillSignal=SIGTERM
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX
SyslogIdentifier=witness-gateway

[Install]
WantedBy=multi-user.target
